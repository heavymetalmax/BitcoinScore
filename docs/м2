//@version=5
indicator('M2 Money Shift for Bitcoin [SAKANE]', overlay=true, scale=scale.left)

// Slide days
slide_days = input.int(defval=70, title="Slide Days Forward", minval=0, maxval=500, tooltip="Number of bars to slide the indicator forward")

// Enable settings for each country's M2
usa_active = input(true, title = "USM2 (USA Money Supply)")
europe_active = input(true, title = "EUM2 (Europe Money Supply)")
china_active = input(true, title = "CNM2 (China Money Supply)")
japan_active = input(true, title = "JPM2 (Japan Money Supply)")
uk_active = input(true, title = "UKM2 (United Kingdom Money Supply)")
canada_active = input(true, title = "CAM2 (Canada Money Supply)")
australia_active = input(true, title = "AUM3 (Australia Money Supply)")
india_active = input(true, title = "INM2 (India Money Supply)")

// Get M2 data for each country and convert to USD
us_m2 = usa_active ? request.security("ECONOMICS:USM2", "D", close) : 0
eu_m2 = europe_active ? request.security("ECONOMICS:EUM2", "D", close) * request.security("FX_IDC:EURUSD", "D", close) : 0
china_m2 = china_active ? request.security("ECONOMICS:CNM2", "D", close) * request.security("FX_IDC:CNYUSD", "D", close) : 0
japan_m2 = japan_active ? request.security("ECONOMICS:JPM2", "D", close) * request.security("FX_IDC:JPYUSD", "D", close) : 0
uk_m2 = uk_active ? request.security("ECONOMICS:GBM2", "D", close) * request.security("FX_IDC:GBPUSD", "D", close) : 0
canada_m2 = canada_active ? request.security("ECONOMICS:CAM2", "D", close) * request.security("FX_IDC:CADUSD", "D", close) : 0
australia_m2 = australia_active ? request.security("ECONOMICS:AUM3", "D", close) * request.security("FX_IDC:AUDUSD", "D", close) : 0
india_m2 = india_active ? request.security("ECONOMICS:INM2", "D", close) * request.security("FX_IDC:INRUSD", "D", close) : 0

// Calculate total liquidity
total = (us_m2 + eu_m2 + china_m2 + japan_m2 + uk_m2 + canada_m2 + australia_m2 + india_m2) / 1000000000000

// Plot total liquidity with a single color
plot(total, offset=slide_days, color=color.blue, linewidth=2)
