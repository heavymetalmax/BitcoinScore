//@version=6
indicator('BTC NUPL', shorttitle = 'BTC NUPL', overlay = false)

//───────────────────────────
// Inputs
//────────────────────────────
smaPeriod = input.int(
     title  = 'Smoothing Period',
     defval = 7,
     minval = 1,
     group  = 'Settings'
 )

showSmoothed = input.bool(
     title  = 'Show Smoothed Line',
     defval = true,
     group  = 'Settings'
 )

//────────────────────────────
// Data
//────────────────────────────
btc_mcap     = request.security('BTC_MARKETCAP',     timeframe.period, close)
btc_realized = request.security('BTC_MARKETCAPREAL', timeframe.period, close)

//────────────────────────────
// Calculations
//────────────────────────────
nupl         = (btc_mcap - btc_realized) / btc_mcap
nuplSmoothed = ta.sma(nupl, smaPeriod)

//────────────────────────────
// Zone colors
//────────────────────────────
zoneColor(val) =>
    val >= 0.75 ? color.new(color.red, 0) :
     val >= 0.50 ? color.new(color.orange, 0) :
     val >= 0.25 ? color.new(color.yellow, 0) :
     val >= 0.0  ? color.new(color.green, 0) :
     color.new(color.red, 30)

//────────────────────────────
// Plots
//────────────────────────────
plot(nupl, color = zoneColor(nupl), linewidth = 2, title = 'NUPL')
plot(showSmoothed ? nuplSmoothed : na, color = color.new(color.white, 30), linewidth = 1, title = 'NUPL Smoothed')

// Zone reference lines
hline(0.75, 'Euphoria',        color = color.new(color.red,    50), linestyle = hline.style_dotted, linewidth = 1)
hline(0.50, 'Belief',          color = color.new(color.orange, 50), linestyle = hline.style_dotted, linewidth = 1)
hline(0.25, 'Optimism',        color = color.new(color.yellow, 50), linestyle = hline.style_dotted, linewidth = 1)
hline(0.0,  'Break-Even',      color = color.new(#e69704,       0), linestyle = hline.style_dashed, linewidth = 1)
hline(-0.25,'Capitulation',    color = color.new(color.green,  50), linestyle = hline.style_dotted, linewidth = 1)

//────────────────────────────
// Bar coloring
//────────────────────────────
BARCOLOR = input.bool(true, 'BAR COLORING', group = 'Universal Tester')
barcolor(BARCOLOR ? zoneColor(nupl) : na)